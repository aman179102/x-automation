# ==============================================================================
# X (Twitter) API v2 Credentials (OAuth 1.0a User Context)
# Get these from the Twitter Developer Portal (https://developer.x.com/en/portal/dashboard)
# Make sure your App Permissions are set to "Read and Write"!
# ==============================================================================
X_API_KEY=your_consumer_api_key_here
X_API_SECRET=your_consumer_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=

# ==============================================================================
# Personal Branding & Reputation (Used in Image Banner & Showcase Posts)
# ==============================================================================
AUTHOR_NAME=Aman Kumar
AUTHOR_HANDLE=@aman179102
AUTHOR_TITLE=Systems & AI Engineer
GITHUB_USER=aman179102
PORTFOLIO_URL=https://github.com/aman179102

# ==============================================================================
# AI Content Generation (Gemini, Groq, or OpenRouter)
# At least one key is recommended for AI drafts; fallback template is used if empty.
# ==============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ==============================================================================
# Image Generation Settings
# IMAGE_MODE can be:
#   "ai"    -> Dynamic Pollinations.ai (100% Free, No API key needed, zero copyright risk)
#   "stock" -> Pexels API (Royalty-free photography, requires free PEXELS_API_KEY)
#   "card"  -> Pure local dark graphic card with Pillow
# ==============================================================================
IMAGE_MODE=ai
PEXELS_API_KEY=

# ==============================================================================
# Scheduling & Posting Safety Limits
# ==============================================================================
TIMEZONE=Asia/Kolkata
DAILY_POST_CAP=4
MIN_SPACING_MINUTES=120
POSTING_WINDOW_START=08:00
POSTING_WINDOW_END=23:30

# Probability of featuring an open-source project showcase (0.20 = 20%)
SHOWCASE_RATIO=0.20

# Optional integrations
GITHUB_TOKEN=
HEALTHCHECK_URL=

# ==============================================================================
# Telegram 1-Tap Mobile Co-Pilot (100% Ban-Proof & Lock-Proof)
# Create a bot via @BotFather on Telegram and get your chat ID from @userinfobot
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# Satellite / Shield Account Network (SEO & Authority Multiplier)
# A secondary Twitter account used to monitor & quote-reply systems engineering
# discussions, organically citing @aman179102 and your GitHub repos.
# ==============================================================================
SATELLITE_AUTH_TOKEN=
SATELLITE_CT0=
SATELLITE_HANDLE=@TechArchDigest
SATELLITE_MAX_DAILY=3
